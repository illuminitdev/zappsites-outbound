# --- Core ---
# Public base URL of this app (used for prospect audit pages and unsubscribe links)
APP_URL=https://outbound.yourdomain.co.uk
# Dashboard login (HTTP basic auth). Username is "admin".
ADMIN_PASSWORD=change-me
# Shared secret for cron endpoints: send as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-too

# --- Supabase (service role: server-side only, never expose) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Lead sources (all optional; CSV import always works) ---
# Free: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# Google Places API (New) - Text Search
GOOGLE_PLACES_API_KEY=
# Optional email finder + verifier (https://hunter.io). Without it the engine scrapes
# contact pages and checks MX records only.
HUNTER_API_KEY=

# --- Audits ---
# Free key from Google Cloud (PageSpeed Insights API). Works without a key at low volume.
PAGESPEED_API_KEY=

# --- AEO/GEO mentions audit ---
# Each engine is switched on by its key. Claude uses ANTHROPIC_API_KEY (disable with AEO_CLAUDE=false).
# Cost: prompts x engines calls per lead (default 3 prompts). Set the campaign's "AEO category" to enable.
OPENAI_API_KEY=
OPENAI_AEO_MODEL=gpt-5
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AEO_MAX_PROMPTS=3
# Questions are written from each lead's own services (one Claude call reads their homepage + services page).
# Optional cheaper model for that step, e.g. claude-haiku-5-5. Defaults to ANTHROPIC_MODEL.
AEO_PROFILE_MODEL=
# Claude answers with live web search (like ChatGPT search). Set false for model-knowledge only.
AEO_CLAUDE_WEB_SEARCH=true
AEO_CLAUDE_SEARCH_TOOL=web_search_20250305

# --- Brand (everything prospects see: emails, audit page, unsubscribe) ---
# Defaults are ZappSites' public details; only set what you want to change.
BRAND_NAME=ZappSites
BRAND_TAGLINE=Get found. Get booked. Get paid.
BRAND_URL=https://www.zappsites.com
BRAND_LOGO_URL=https://zappsites-prod-uploads-288761766237.s3.us-east-1.amazonaws.com/images/brand/logo.png
# Set this to the ZappSites brand colour (hex). Used for buttons, links and the signature avatar.
BRAND_ACCENT=#1d4ed8
BRAND_EMAIL=info@zappsites.com
BRAND_PHONE=020 3488 6301
BRAND_ADDRESS=160 City Road, London EC1V 2NX
BRAND_PERSON=Ram
BRAND_PERSON_ROLE=Founder
# Legal entity behind ZappSites, if it's a trading name. Shown as "ZappSites (a trading name of ...)".
SENDER_COMPANY=
# Where the weekly report is emailed
REPORT_TO=you@yourdomain.co.uk

# --- Built-in booking page (audit.zappsites.com/book) ---
# Defaults: any day, 08:00-20:00 UK time, 15-minute slots, at least 2 hours' notice, 14 days ahead.
BOOKING_TIMEZONE=Europe/London
BOOKING_DAYS=1,2,3,4,5,6,7
BOOKING_START_HOUR=8
BOOKING_END_HOUR=20
BOOKING_SLOT_MINUTES=15
BOOKING_MIN_NOTICE_HOURS=2
BOOKING_DAYS_AHEAD=14
# Optional: your permanent Google Meet / Zoom link. If set, people can choose a video call instead of a phone call.
BOOKING_VIDEO_URL=
# Where new-booking alerts go (defaults to REPORT_TO)
BOOKING_NOTIFY_EMAIL=

# --- Google Ads (public /check landing page) ---
# Conversion tag ID and labels from Google Ads > Goals > Conversions. Tag only loads after cookie consent.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_ADS_LABEL_CHECK=
NEXT_PUBLIC_ADS_LABEL_BOOK=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Shares the same cookie banner as the Ads tag.
NEXT_PUBLIC_GA_ID=
